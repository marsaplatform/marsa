{
  "name": "marsa",
  "version": "0.6.0",
  "private": true,
  "description": "Marsa: a lightweight, self-hostable drop-in for static sites. Upload files or a ZIP, get a shareable link that expires on its own. No accounts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.13",
    "marked": "^18.1.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^20.19.0",
    "@types/yauzl": "^3.4.0",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
