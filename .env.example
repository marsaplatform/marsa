# Marsa configuration. Copy to .env and adjust. Every value is optional.
# Placeholders only. Never commit a real .env.

# --- server ---
PORT=8080
HOST=0.0.0.0
# Public base URL used to build share links (no trailing slash).
PUBLIC_URL=http://localhost:8080
# Where uploaded sites live. Mount a volume here in Docker.
DATA_DIR=./data

# --- link lifetime (hours) ---
DEFAULT_TTL_HOURS=24
MIN_TTL_HOURS=1
# 168 = 7 days. A link can never outlive created_at + MAX_TTL_HOURS.
MAX_TTL_HOURS=168
SWEEP_INTERVAL_SECONDS=60

# --- abuse limits ---
MAX_FILE_MB=10
MAX_SITE_MB=25
MAX_FILES=500
UPLOADS_PER_HOUR=20
API_REQUESTS_PER_MINUTE=120
# Set true ONLY behind a reverse proxy you control (uses X-Real-IP / last X-Forwarded-For hop).
TRUST_PROXY=false

# --- optional self-host admin ---
# Leave empty to disable the admin API. Otherwise use a long random value (>= 24 chars),
# e.g. generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# --- optional data/files backend (Appwrite) ---
# Off unless ALL four required values are set. Static publishing never needs it.
# Works with Appwrite Cloud (no server to install) or a self-hosted Appwrite.
# The API key stays on the server; browsers never see it.
APPWRITE_ENDPOINT=
# e.g. https://cloud.appwrite.io/v1 or https://appwrite.example.com/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
# Optional, these are the defaults:
APPWRITE_KV_TABLE_ID=marsa_kv
APPWRITE_BUCKET_ID=marsa_files
# Who may use the backend: false (default) = only sites of teams the admin gave backend access
# (manage teams at /admin); true = every site, guests included.
BACKEND_GUEST_ACCESS=false
# Anyone may read a live site's KV values and files; writes always need the edit token.
BACKEND_PUBLIC_READ=true
BACKEND_MAX_VALUE_KB=64
BACKEND_MAX_KEYS=1000
BACKEND_MAX_FILES=100
