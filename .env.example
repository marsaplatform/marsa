# Marsa configuration. Copy to .env and adjust. Every value is optional.
# Placeholders only. Never commit a real .env.

# --- server ---
PORT=8080
HOST=0.0.0.0
# Public base URL used to build share links (no trailing slash).
PUBLIC_URL=http://localhost:8080
# Where uploaded sites live. Mount a volume here in Docker.
DATA_DIR=./data

# --- link lifetime (hours) ---
DEFAULT_TTL_HOURS=24
MIN_TTL_HOURS=1
# 168 = 7 days. A link can never outlive created_at + MAX_TTL_HOURS.
MAX_TTL_HOURS=168
SWEEP_INTERVAL_SECONDS=60

# --- abuse limits ---
MAX_FILE_MB=10
MAX_SITE_MB=25
MAX_FILES=500
UPLOADS_PER_HOUR=20
API_REQUESTS_PER_MINUTE=120
# Set true ONLY behind a reverse proxy you control (uses X-Real-IP / last X-Forwarded-For hop).
TRUST_PROXY=false

# --- optional self-host admin ---
# Leave empty to disable the admin API. Otherwise use a long random value (>= 24 chars),
# e.g. generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# --- optional data/files backend (Cloudflare Workers KV + R2) ---
# Off unless ALL five required values are set. Static publishing never needs it.
# Nothing to install: Marsa calls Cloudflare's HTTP APIs. Create the namespace and bucket with
#   node scripts/cloudflare-setup.mjs --write-env .env
# Token permissions: Workers KV Storage: Edit + Workers R2 Storage: Edit. Secrets stay on the server.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=
# R2 S3 keys: Access Key ID = the API token's id, Secret = sha256(token value) (the setup script derives them),
# or a separate R2 API token's key pair.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional, this is the default:
R2_BUCKET=marsa-files
# Only for EU/FedRAMP jurisdiction buckets, e.g. https://<account>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
# Who may use the backend: false (default) = only sites of teams the admin gave backend access
# (manage teams at /admin); true = every site, guests included.
BACKEND_GUEST_ACCESS=false
# Anyone may read a live site's KV values and files; writes always need the edit token.
BACKEND_PUBLIC_READ=true
BACKEND_MAX_VALUE_KB=64
BACKEND_MAX_KEYS=1000
BACKEND_MAX_FILES=100

# --- browser sign-in (team dashboard at /login, admin at /admin/login) ---
# HMAC key for session cookies and CSRF tokens, >= 32 chars, e.g. `openssl rand -hex 32`.
# Empty = a random key per start (everyone is signed out on restart).
SESSION_SECRET=
# Team sessions last 7 days, admin sessions 12 hours.
SESSION_TTL_HOURS=168
ADMIN_SESSION_TTL_HOURS=12
# Sign-in attempts per client IP per 15 minutes (team and admin together).
LOGIN_ATTEMPTS_PER_15_MIN=10

# --- home page ---
# Site ids to spotlight in the "Featured" slot, comma-separated (the first live one is shown).
# Empty = the newest page in the public directory.
FEATURED_SITES=

# --- team quotas (permanent sites never expire, so cap them) ---
# Default per team; the admin can override per team in the console or the admin API.
TEAM_MAX_SITES=50
TEAM_MAX_MB=200

# --- MCP per space (/mcp/s/<siteId>, tokens on the site page) ---
MCP_REQUESTS_PER_MINUTE=60
MCP_WRITES_PER_HOUR=60
# Instance-wide; Cloudflare's free KV plan allows 1000 writes/day per account.
MCP_KV_WRITES_PER_DAY=500
