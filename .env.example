# Marsa configuration. Copy to .env and adjust. Every value is optional.
# Placeholders only. Never commit a real .env.

# --- server ---
PORT=8080
HOST=0.0.0.0
# Public base URL used to build share links (no trailing slash).
PUBLIC_URL=http://localhost:8080
# Where uploaded sites live. Mount a volume here in Docker.
DATA_DIR=./data

# --- link lifetime (hours) ---
DEFAULT_TTL_HOURS=24
MIN_TTL_HOURS=1
# 168 = 7 days. A link can never outlive created_at + MAX_TTL_HOURS.
MAX_TTL_HOURS=168
SWEEP_INTERVAL_SECONDS=60

# --- abuse limits ---
MAX_FILE_MB=10
MAX_SITE_MB=25
MAX_FILES=500
UPLOADS_PER_HOUR=20
API_REQUESTS_PER_MINUTE=120
# Set true ONLY behind a reverse proxy you control (uses X-Real-IP / last X-Forwarded-For hop).
TRUST_PROXY=false

# --- optional self-host admin ---
# Leave empty to disable the admin API. Otherwise use a long random value (>= 24 chars),
# e.g. generate one with: openssl rand -hex 32
ADMIN_TOKEN=
